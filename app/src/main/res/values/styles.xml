<resources>
    <!--Style para EditText -->
    <style name="CustomEditTextStyle">
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textColor">@android:color/black</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--Style para TextView -->
    <style name="CustomTextStyle">
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!--Style para Button -->
    <style name="CustomButtonStyle">
        <item name="android:fontFamily">@font/roboto</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!--Style para PopUpMenu -->
    <style name="PopupMenuInventory" parent="Widget.AppCompat.PopupMenu">
        <item name="android:textColor">?attr/colorTextPrimary</item>
        <item name="android:backgroundTint">?attr/colorPopupBackground</item>
        <item name="android:itemBackground">@drawable/popup_menu_inventory_background</item>
        <item name="android:fontFamily">@font/roboto_light</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheetStyle</item>
    </style>

    <style name="CustomBottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">?attr/colorCardBackground</item>
    </style>

    <style name="RecipeIndicator">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:drawablePadding">4dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:fontFamily">@font/roboto_light</item>
    </style>


</resources>
