<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="?attr/colorBackground"

    tools:context=".navigation.ScannerFragment">

    <!-- CABECERA -->
    <LinearLayout
        android:id="@+id/headerLayoutScanner"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:background="?attr/colorHeaderBackground"
        android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGreetingScanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/hola_usuario"
                android:textColor="?attr/colorHeaderText"
                android:textSize="24sp"
                tools:ignore="RelativeOverlap" />

            <LinearLayout
                android:id="@+id/headerIconsScanner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAccountScanner"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="24dp"
                    android:src="@drawable/account2"
                    android:contentDescription="@string/icono"
                    app:tint="?attr/colorHeaderText" />

                <ImageView
                    android:id="@+id/btnSettingsScanner"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/settings"
                    app:tint="?attr/colorHeaderText" />
            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/textInfoScanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_light"
            android:text="@string/esc_ner"
            android:textColor="?attr/colorHeaderText"
            android:textSize="34sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">
        <!-- CONTENEDOR DE IMAGEN -->
        <FrameLayout
            android:id="@+id/imageContainer"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_image_placeholder"
            android:foreground="?android:attr/selectableItemBackground">

            <!-- Imagen escaneada -->
            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <!-- Contenido por defecto -->
            <LinearLayout
                android:id="@+id/defaultImageLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <ImageView
                    android:id="@+id/ScannedImage"
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:src="@drawable/ic_error_placeholder" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/aqu_se_mostrar_la_imagen_escaneada"
                    android:textColor="@color/darker_gray"
                    android:textSize="16sp"
                    android:paddingTop="12dp"
                    android:gravity="center" />
            </LinearLayout>
        </FrameLayout>

        <!-- TEXTO DE ESTADO -->
        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="16sp"
            android:text="@string/esperando_escaneo" />

        <!-- PROGRESO -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:visibility="gone" />

        <!-- BOTÓN ESCANEAR -->
        <Button
            android:id="@+id/btnScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="60dp"
            android:layout_marginTop="24dp"
            android:text="@string/escanear_producto"
            android:backgroundTint="?attr/colorBackgroundButton"
            android:textColor="?attr/colorTextButton"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
