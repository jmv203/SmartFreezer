<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" >

    <!-- Cabecera Morada -->
    <LinearLayout
        android:id="@+id/headerLayoutWastedProducts"
        android:layout_width="match_parent"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:background="?attr/colorHeaderBackground"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Saludo y Iconos -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGreetingWastedProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/hola_usuario"
                android:textColor="?attr/colorHeaderText"
                android:textSize="24sp"
                tools:ignore="RelativeOverlap" />

            <LinearLayout
                android:id="@+id/headerIconsWastedProducts"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAccountWastedProducts"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/account2"
                    app:tint="?attr/colorHeaderText"/>

                <ImageView
                    android:id="@+id/btnSettingsWastedProducts"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/settings"
                    app:tint="?attr/colorHeaderText"/>
            </LinearLayout>
        </RelativeLayout>
        <TextView
            android:id="@+id/tvWastedProducts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/productos_desperdiciados"
            android:textSize="34sp"
            android:textColor="?attr/colorHeaderText"
            android:fontFamily="@font/roboto_light" />

    </LinearLayout>
    <!-- Selector: Inventario / Historial -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabSelectorWasted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/tabBackgroundColor"
        app:tabIndicatorColor="?attr/colorTextPrimary"
        app:tabSelectedTextColor="?attr/colorTextPrimary"
        app:tabTextColor="?attr/colorTextSecondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inventario" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historial" />

    </com.google.android.material.tabs.TabLayout>



    <!-- Encabezado mejorado -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Selector de periodo -->
        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/periodToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:checkedButton="@id/btnWeekly">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnWeekly"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/weekly"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMonthly"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/monthly"/>
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <!-- Texto del periodo actual -->
        <TextView
            android:id="@+id/tvPeriodTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <!-- Gráfico deslizable -->
        <HorizontalScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:layout_marginTop="16dp"
            android:fillViewport="true">

            <com.github.mikephil.charting.charts.BarChart
                android:id="@+id/barChart"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:minWidth="1000dp"/>
        </HorizontalScrollView>

        <!-- Navegación -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnPrev"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/previous"/>

            <Button
                android:id="@+id/btnNext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/next"/>
        </LinearLayout>

        <!-- Resumen -->
        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textAlignment="center"
            android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
