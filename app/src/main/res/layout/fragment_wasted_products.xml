<!-- Modifica el LinearLayout principal para que sea scrollable -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Cabecera Morada -->
        <LinearLayout
            android:id="@+id/headerLayoutWastedProducts"
            android:layout_width="match_parent"
            android:layout_height="175dp"
            android:orientation="vertical"
            android:background="?attr/colorHeaderBackground"
            android:padding="16dp">

            <!-- Saludo y Iconos -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvGreetingWastedProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_light"
                    android:text="@string/hola_usuario"
                    android:textColor="?attr/colorHeaderText"
                    android:textSize="24sp"
                    tools:ignore="RelativeOverlap" />

                <LinearLayout
                    android:id="@+id/headerIconsWastedProducts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnAccountWastedProducts"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="24dp"
                        android:contentDescription="@string/icono"
                        android:src="@drawable/account2"
                        app:tint="?attr/colorHeaderText"/>

                    <ImageView
                        android:id="@+id/btnSettingsWastedProducts"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/icono"
                        android:src="@drawable/settings"
                        app:tint="?attr/colorHeaderText"/>
                </LinearLayout>
            </RelativeLayout>
            <TextView
                android:id="@+id/tvWastedProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/productos_desperdiciados"
                android:textSize="34sp"
                android:textColor="?attr/colorHeaderText"
                android:fontFamily="@font/roboto_light" />
        </LinearLayout>

        <!-- Selector: Inventario / Historial -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabSelectorWasted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/tabBackgroundColor"
            app:tabIndicatorColor="?attr/colorTextPrimary"
            app:tabSelectedTextColor="?attr/colorTextPrimary"
            app:tabTextColor="?attr/colorTextSecondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/inventario" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/historial" />
        </com.google.android.material.tabs.TabLayout>

        <!-- Encabezado mejorado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Selector de periodo -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/periodToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:singleSelection="true"
                app:checkedButton="@id/btnWeekly">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWeekly"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/weekly"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMonthly"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/monthly"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Texto del periodo actual -->
            <TextView
                android:id="@+id/tvPeriodTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textAlignment="center"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <!-- Contenedor para los gráficos -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvNoData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_wasted_data"
                    android:gravity="center"
                    android:visibility="gone"
                    android:textSize="18sp"
                    android:padding="60dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:layout_marginTop="16dp" />

                <com.github.mikephil.charting.charts.BarChart
                    android:id="@+id/barChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="16dp" />

                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pieChart"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginTop="16dp"
                    android:visibility="gone"/>
            </LinearLayout>

            <!-- Selector de tipo de gráfico -->
            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/chartTypeToggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="true"
                app:checkedButton="@id/btnBarChart">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBarChart"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/bar_chart"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPieChart"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/pie_chart"/>
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <!-- Navegación -->
            <LinearLayout
                style="?android:attr/buttonBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/btnPrev"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="@string/previous"
                    android:textColor="?attr/colorTextButton"
                    android:backgroundTint="?attr/colorBackgroundButton" />

                <Button
                    android:id="@+id/btnNext"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="?attr/colorBackgroundButton"
                    android:text="@string/next"
                    android:textColor="?attr/colorTextButton"/>
            </LinearLayout>

            <!-- Resumen -->
            <TextView
                android:id="@+id/tvSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:textAlignment="center"
                android:textSize="16sp"/>

        </LinearLayout>
    </LinearLayout>
</ScrollView>