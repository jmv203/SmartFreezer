<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/homeFragmentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".navigation.InventoryFragment">

    <!-- Cabecera Morada -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="0dp"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:background="?attr/colorHeaderBackground"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Saludo y Iconos -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGreeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/hola_usuario"
                android:textColor="?attr/colorHeaderText"
                android:textSize="24sp"
                tools:ignore="RelativeOverlap" />

            <LinearLayout
                android:id="@+id/headerIcons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAccountInventory"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/account2"
                    app:tint="?attr/colorHeaderText"/>

                <ImageView
                    android:id="@+id/btnSettingsInventory"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/settings"
                    app:tint="?attr/colorHeaderText"/>

            </LinearLayout>
        </RelativeLayout>

        <!-- Barra de búsqueda -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="?attr/colorSearchBarBackground"
            app:cardCornerRadius="25dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="@string/icono"
                    app:tint="?attr/colorTextSecondary"
                    android:src="@drawable/search" />

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:autofillHints=""
                    android:background="?attr/colorSearchBarBackground"
                    android:fontFamily="@font/roboto"
                    android:hint="@string/qu_buscas"
                    android:inputType="text"
                    android:minHeight="48dp"
                    android:textColor="?attr/colorTextPrimary"
                    android:textColorHint="?attr/colorTextSecondary" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

    <!-- Selector: Inventario / Historial -->
    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabSelectorInventory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/tabBackgroundColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayout"
        app:tabIndicatorColor="?attr/colorTextPrimary"
        app:tabSelectedTextColor="?attr/colorTextPrimary"
        app:tabTextColor="?attr/colorTextSecondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/inventario" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/historial" />

    </com.google.android.material.tabs.TabLayout>

    <!-- Ubicación y filtro -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/locationInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabSelectorInventory"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.skydoves.powerspinner.PowerSpinnerView
            android:id="@+id/spinnerLocation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="@string/donde_esta"
            android:padding="10dp"
            android:textAlignment="textStart"
            android:textColor="?attr/colorTextPrimary"
            android:textColorHint="?attr/colorTextPrimary"
            android:textSize="24sp"
            app:fontFamily="@font/roboto_light"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/filterButtonContainer"
            app:spinner_arrow_animate="true"
            app:spinner_arrow_gravity="end"
            app:spinner_arrow_padding="2dp"
            app:spinner_arrow_tint="?attr/colorTextPrimary"
            app:spinner_debounce_duration="25"
            app:spinner_divider_color="?attr/colorTextPrimary"
            app:spinner_divider_show="true"
            app:spinner_divider_size="0.8dp"
            app:spinner_item_array="@array/locations_array"
            app:spinner_item_height="60dp"
            app:spinner_popup_animation="dropdown"
            app:spinner_popup_background="?attr/colorPopupBackground"
            app:spinner_popup_elevation="14dp" />

        <FrameLayout
            android:id="@+id/filterButtonContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="@+id/spinnerLocation"
            app:layout_constraintBottom_toBottomOf="@+id/spinnerLocation"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterOptions"
                android:layout_width="130dp"
                android:layout_height="wrap_content"
                android:backgroundTint="?attr/colorBackgroundFilterButton"
                android:elevation="2dp"
                android:paddingHorizontal="12dp"
                android:text="@string/filtrar"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="14sp"
                app:fontFamily="@font/roboto"
                app:icon="@drawable/filter"
                app:iconGravity="textStart"
                app:iconTint="?attr/colorTextPrimary"
                app:strokeColor="?attr/colorTextPrimary"
                android:foreground="?attr/selectableItemBackground"
                app:strokeWidth="2dp" />

            <TextView
                android:id="@+id/filterBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/badge_circle"
                android:text="1"
                android:textStyle="bold"
                android:textColor="?attr/colorTextTertiary"
                android:textSize="12sp"
                android:gravity="center"
                android:visibility="gone"
                tools:ignore="HardcodedText" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvProductCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/roboto"
            android:text="5 productos encontrados"
            android:textColor="@android:color/darker_gray"
            android:textSize="14sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/spinnerLocation"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Grid de productos -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvInventory"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="4dp"
        android:padding="8dp"
        app:layout_constraintTop_toBottomOf="@id/locationInfo"
        app:layout_constraintBottom_toTopOf="@id/fabAddProduct"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_product_inventory" />


    <!-- Botón Flotante para añadir producto -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddProduct"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="@string/agregar_producto"
        android:src="@drawable/add"
        app:backgroundTint="?attr/colorTextPrimary"
        app:tint="?attr/colorTextTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <!-- Barra de navegación (ya está en HomeActivity) -->
</androidx.constraintlayout.widget.ConstraintLayout>
