<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.org/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    android:id="@+id/recipesFragmentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".navigation.RecipesFragment">

    <LinearLayout
        android:id="@+id/headerLayoutRecipe"
        android:layout_width="0dp"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:background="?attr/colorHeaderBackground"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGreetingRecipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/hola_usuario"
                android:textColor="?attr/colorHeaderText"
                android:textSize="24sp"
                tools2:ignore="RelativeOverlap" />

            <LinearLayout
                android:id="@+id/headerIconsRecipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAccountRecipe"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="24dp"
                    android:src="@drawable/account2"
                    android:contentDescription="@string/icono"
                    app:tint="?attr/colorHeaderText"/>

                <ImageView
                    android:id="@+id/btnSettingsRecipe"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/settings"
                    app:tint="?attr/colorHeaderText"/>

            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/textInfoRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_light"
            android:text="@string/recetas_disponibles"
            android:textColor="?attr/colorHeaderText"
            android:textSize="34sp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabSelectorRecipe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/tabBackgroundColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayoutRecipe"
        app:tabIndicatorColor="?attr/colorTextPrimary"
        app:tabSelectedTextColor="?attr/colorTextPrimary"
        app:tabTextColor="?attr/colorTextSecondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recetas_disponibles" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recetas_guardadas" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/filterButtonContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabSelectorRecipe"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterRecipes"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorBackgroundFilterButton"
            android:elevation="2dp"
            android:paddingHorizontal="12dp"
            android:text="@string/filtrar"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="14sp"
            app:fontFamily="@font/roboto"
            app:icon="@drawable/filter"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorTextPrimary"
            app:strokeColor="?attr/colorTextPrimary"
            android:foreground="?attr/selectableItemBackground"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/filterCountRecipe"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/badge_circle"
            android:text="1"
            android:textColor="?attr/colorTextTertiary"
            android:textSize="12sp"
            android:gravity="center"
            android:visibility="gone"
            tools2:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/btnClearFilters"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:visibility="gone"
            android:background="@drawable/badge_circle"
            android:contentDescription="@string/icono"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorTextTertiary"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <com.facebook.shimmer.ShimmerFrameLayout
        android:id="@+id/shimmerLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/filterButtonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <include layout="@layout/item_recipe_shimmer" />
            <include layout="@layout/item_recipe_shimmer" />
            <include layout="@layout/item_recipe_shimmer" />
        </LinearLayout>

    </com.facebook.shimmer.ShimmerFrameLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefreshLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/filterButtonContainer"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recipesRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:clipToPadding="false"
            android:visibility="gone"
            android:padding="8dp"
            app:layout_constraintTop_toBottomOf="@id/filterButtonContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:listitem="@layout/recipes_row_layout" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Botón flotante para refrescar -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnLoadMore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/ic_refresh"
        android:contentDescription="@string/refresh"
        android:backgroundTint="?attr/colorTextPrimary"
        app:tint="?attr/colorTextTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>