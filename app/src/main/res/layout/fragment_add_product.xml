<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Título categoría -->
        <TextView
            android:id="@+id/categoryTitle"
            android:text="Categoría"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Icono + nombre -->
        <LinearLayout
            android:id="@+id/iconNameLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/categoryTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/productIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginEnd="16dp"
                android:contentDescription="Icono" />

            <TextView
                android:id="@+id/productName"
                android:text="Nombre"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fecha de compra -->
        <TextView
            android:id="@+id/purchaseDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de compra"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/iconNameLayout"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/purchaseDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="dd/MM/yyyy"
            android:inputType="date"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/purchaseDateLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Fecha de caducidad -->
        <TextView
            android:id="@+id/expirationDateLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fecha de caducidad"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/purchaseDateInput"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/expirationDateInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="dd/MM/yyyy"
            android:inputType="date"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/expirationDateLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Ubicación -->
        <TextView
            android:id="@+id/locationLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ubicación"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/expirationDateInput"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/locationSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/locationLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Condición -->
        <TextView
            android:id="@+id/conditionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Condición"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/locationSpinner"
            app:layout_constraintStart_toStartOf="parent" />

        <Spinner
            android:id="@+id/conditionSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/conditionLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Cantidad -->
        <TextView
            android:id="@+id/quantityLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cantidad"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/conditionSpinner"
            app:layout_constraintStart_toStartOf="parent" />

        <LinearLayout
            android:id="@+id/quantitySpace"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/quantityLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="50dp"
                    android:layout_height="35dp"
                    app:icon="@drawable/subtract"
                    app:iconSize="16dp"
                    app:iconTint="@color/white"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/purpleButton" />

                <TextView
                    android:id="@+id/quantityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:text="1"
                    android:textSize="18sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="50dp"
                    android:layout_height="35dp"
                    app:icon="@drawable/add"
                    app:iconSize="20dp"
                    app:iconTint="@color/white"
                    app:iconPadding="0dp"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/purpleButton" />
            </LinearLayout>
        </LinearLayout>

        <!-- Botón guardar -->
        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar"
            android:textColor="@color/white"
            app:backgroundTint="@color/purpleButton"
            app:layout_constraintTop_toBottomOf="@+id/quantitySpace"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
