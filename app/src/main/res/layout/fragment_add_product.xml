<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/headerLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="?attr/colorHeaderBackground"
            android:orientation="vertical"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:id="@+id/btnBackAddProduct"
                    android:layout_width="35dp"
                    android:layout_height="35dp"
                    android:layout_alignParentStart="true"
                    android:contentDescription="@string/volver"
                    android:src="@drawable/baseline_arrow_back_24"
                    app:tint="?attr/colorHeaderText" />

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/a_ade_el_producto"
                    android:textColor="?attr/colorHeaderText"
                    android:textSize="24sp"
                    android:fontFamily="@font/roboto_light" />
            </RelativeLayout>

            <LinearLayout
                android:id="@+id/iconNameLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/categoryTitle">

                <ImageView
                    android:id="@+id/productIcon"
                    android:layout_width="0dp"
                    android:layout_weight="0.4"
                    android:layout_height="64dp"
                    android:layout_marginEnd="16dp"
                    android:contentDescription="@string/icono"
                    app:srcCompat="@drawable/apple" />

                <TextView
                    android:id="@+id/categoryTitle"
                    android:layout_width="0dp"
                    android:layout_weight="0.3"
                    android:layout_height="wrap_content"
                    android:text="@string/categor_a"
                    android:textAlignment="textStart"
                    android:textSize="22sp"
                    android:fontFamily="@font/roboto"
                    android:textColor="?attr/colorHeaderText"/>

                <TextView
                    android:id="@+id/productName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.3"
                    android:text="@string/nombre"
                    android:textAlignment="center"
                    android:textSize="22sp"
                    android:fontFamily="@font/roboto_light"
                    android:textColor="?attr/colorHeaderText" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/formLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="30dp"
            android:layout_marginEnd="30dp"
            android:textColor="?attr/colorTextPrimary"
            app:layout_constraintTop_toBottomOf="@id/headerLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/locationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/ubicaci_n"
                android:textSize="20sp"
                android:textColor="?attr/colorTextPrimary"
                android:fontFamily="@font/roboto" />

            <com.skydoves.powerspinner.PowerSpinnerView
                android:id="@+id/locationSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/seleccione_una_opci_n"
                android:minHeight="48dp"
                android:textAlignment="textStart"
                android:textColor="?attr/colorTextPrimary"
                android:textColorHint="?attr/colorTextPrimary"
                android:textSize="18sp"
                app:spinner_arrow_animate="true"
                app:spinner_arrow_gravity="end"
                app:spinner_arrow_padding="2dp"
                app:spinner_arrow_tint="?attr/colorTextPrimary"
                app:spinner_debounce_duration="25"
                app:spinner_divider_color="?attr/colorTextPrimary"
                app:spinner_divider_show="true"
                app:spinner_divider_size="0.8dp"
                app:spinner_popup_animation="dropdown"
                app:spinner_item_height="40dp"
                app:spinner_popup_background="?attr/colorPopupBackground"
                app:spinner_popup_elevation="8dp"
                tools:ignore="DuplicateSpeakableTextCheck" />

            <TextView
                android:id="@+id/conditionLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="20sp"
                android:text="@string/condici_n"
                android:fontFamily="@font/roboto" />

            <com.skydoves.powerspinner.PowerSpinnerView
                android:id="@+id/conditionSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/seleccione_una_opci_n"
                android:minHeight="48dp"
                android:textAlignment="textStart"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="18sp"
                android:textColorHint="?attr/colorTextPrimary"
                app:spinner_item_height="40dp"
                app:spinner_arrow_tint="?attr/colorTextPrimary"
                app:spinner_arrow_animate="true"
                app:spinner_arrow_gravity="end"
                app:spinner_arrow_padding="2dp"
                app:spinner_debounce_duration="25"
                app:spinner_divider_color="?attr/colorTextPrimary"
                app:spinner_divider_size="0.8dp"
                app:spinner_divider_show="true"
                app:spinner_popup_background="?attr/colorPopupBackground"
                app:spinner_popup_elevation="8dp"
                app:spinner_popup_animation="dropdown" />

            <TextView
                android:id="@+id/quantityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="@string/cantidad"
                android:textSize="20sp"
                android:textColor="?attr/colorTextPrimary"
                android:fontFamily="@font/roboto" />

            <LinearLayout
                android:id="@+id/quantitySpace"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDecrease"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/boton_de_decrementar"
                    app:backgroundTint="?attr/colorBackgroundButton"
                    app:icon="@drawable/subtract"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="16dp"
                    app:iconTint="?attr/colorTextButton"
                    tools:ignore="TouchTargetSizeCheck" />

                <TextView
                    android:id="@+id/quantityText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:text="1"
                    android:fontFamily="@font/roboto"
                    android:textColor="?attr/colorTextPrimary"
                    android:textSize="22sp"
                    tools:ignore="HardcodedText" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnIncrease"
                    android:layout_width="60dp"
                    android:layout_height="40dp"
                    android:contentDescription="@string/boton_de_incrementar"
                    app:backgroundTint="?attr/colorBackgroundButton"
                    app:icon="@drawable/add"
                    app:iconGravity="textStart"
                    app:iconPadding="0dp"
                    app:iconSize="20dp"
                    app:iconTint="?attr/colorTextButton"
                    tools:ignore="TouchTargetSizeCheck" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/saveButton"
            android:layout_width="300dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/guardar"
            android:textSize="18sp"
            android:textColor="?attr/colorTextButton"
            app:backgroundTint="?attr/colorBackgroundButton"
            android:fontFamily="@font/roboto"
            app:layout_constraintTop_toBottomOf="@+id/formLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>