<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/savedRecipesFragmentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".navigation.SavedRecipesFragment">

    <LinearLayout
        android:id="@+id/headerLayoutSavedRecipes"
        android:layout_width="0dp"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:background="?attr/colorHeaderBackground"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGreetingSavedRecipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/hola_usuario"
                android:textColor="?attr/colorHeaderText"
                android:textSize="24sp"
                tools:ignore="RelativeOverlap" />

            <LinearLayout
                android:id="@+id/headerIconsSavedRecipe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAccountSavedRecipe"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/account2"
                    app:tint="?attr/colorHeaderText"/>

                <ImageView
                    android:id="@+id/btnSettingsSavedRecipe"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/settings"
                    app:tint="?attr/colorHeaderText"/>

            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/textInfoSavedRecipe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_light"
            android:text="@string/recetas_favoritas"
            android:textColor="?attr/colorHeaderText"
            android:textSize="34sp" />
    </LinearLayout>

    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabSelectorSavedRecipe"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="?attr/tabBackgroundColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/headerLayoutSavedRecipes"
        app:tabIndicatorColor="?attr/colorTextPrimary"
        app:tabSelectedTextColor="?attr/colorTextPrimary"
        app:tabTextColor="?attr/colorTextSecondary">

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recetas_disponibles" />

        <com.google.android.material.tabs.TabItem
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recetas_guardadas" />
    </com.google.android.material.tabs.TabLayout>

    <FrameLayout
        android:id="@+id/filterButtonContainerSavedRecipe"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        app:layout_constraintTop_toBottomOf="@id/tabSelectorSavedRecipe"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterSavedRecipes"
            android:layout_width="130dp"
            android:layout_height="wrap_content"
            android:backgroundTint="?attr/colorBackgroundFilterButton"
            android:elevation="2dp"
            android:paddingHorizontal="12dp"
            android:text="@string/filtrar"
            android:textColor="?attr/colorTextPrimary"
            android:textSize="14sp"
            app:fontFamily="@font/roboto"
            app:icon="@drawable/filter"
            app:iconGravity="textStart"
            app:iconTint="?attr/colorTextPrimary"
            app:strokeColor="?attr/colorTextPrimary"
            android:foreground="?attr/selectableItemBackground"
            app:strokeWidth="2dp" />

        <TextView
            android:id="@+id/filterCountSavedRecipe"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="end|top"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/badge_circle"
            android:text="1"
            android:textColor="?attr/colorTextTertiary"
            android:textSize="12sp"
            android:textStyle="bold"
            android:gravity="center"
            android:visibility="gone"
            tools:ignore="HardcodedText" />

        <ImageView
            android:id="@+id/btnClearFiltersSavedRecipe"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="4dp"
            android:layout_marginStart="4dp"
            android:contentDescription="@string/icono"
            android:visibility="gone"
            android:background="@drawable/badge_circle"
            android:src="@drawable/ic_close"
            app:tint="?attr/colorTextTertiary"
            android:clickable="true"
            android:focusable="true" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/filterButtonContainerSavedRecipe"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.facebook.shimmer.ShimmerFrameLayout
            android:id="@+id/shimmerLayoutSavedRecipe"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include layout="@layout/item_recipe_shimmer" />
                <include layout="@layout/item_recipe_shimmer" />
                <include layout="@layout/item_recipe_shimmer" />
            </LinearLayout>

        </com.facebook.shimmer.ShimmerFrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/savedRecipesRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:visibility="gone"
            android:padding="8dp"
            tools:listitem="@layout/recipes_row_layout" />

        <TextView
            android:id="@+id/tvNoFilteredRecipes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:drawablePadding="8dp"
            android:gravity="center"
            android:padding="16dp"
            android:text="@string/no_filtered_saved_recipes"
            android:textAppearance="?attr/textAppearanceBody1"
            android:textColor="@android:color/darker_gray"
            android:visibility="gone" />


        <TextView
            android:id="@+id/tvEmptySavedRecipes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_se_pudieron_cargar_tus_recetas_guardadas_ndesliza_hacia_abajo_para_actualizar"
            android:textAlignment="center"
            android:gravity="center"
            android:padding="16dp"
            android:textColor="@android:color/darker_gray"
            android:layout_gravity="center"
            android:visibility="gone"/>
    </FrameLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnClearSavedRecipes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:src="@drawable/delete"
        android:contentDescription="@string/clear_saved_recipes"
        android:backgroundTint="?attr/colorTextPrimary"
        app:tint="?attr/colorTextTertiary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>