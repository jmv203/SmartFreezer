<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="nutrient"
            type="com.example.smartfreezer.models.Nutrient" />
    </data>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="4dp"
        android:elevation="2dp"
        android:padding="8dp"
        android:backgroundTint="?attr/colorCardBackground"
        android:radius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/nutrientName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@{nutrient.name}"
                android:textStyle="bold"
                android:textColor="?attr/colorTextPrimary"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/nutrientAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:setAmount='@{nutrient.amount}'
                app:setUnit='@{nutrient.unit}'
                android:textColor="?attr/colorTextPrimary"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</layout>
