<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.org/tools"
    xmlns:tools2="http://schemas.android.com/tools"
    android:id="@+id/alertsFragmentLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".navigation.AlertsFragment">

    <!-- Cabecera adaptada -->
    <LinearLayout
        android:id="@+id/headerLayoutAlert"
        android:layout_width="0dp"
        android:layout_height="175dp"
        android:orientation="vertical"
        android:background="?attr/colorHeaderBackground"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:paddingBottom="10dp">

            <TextView
                android:id="@+id/tvGreetingAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/hola_usuario"
                android:textColor="?attr/colorHeaderText"
                android:textSize="24sp"
                tools2:ignore="RelativeOverlap" />

            <LinearLayout
                android:id="@+id/headerIconsAlert"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/btnAccountAlert"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginEnd="24dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/account2"
                    app:tint="?attr/colorHeaderText"/>

                <ImageView
                    android:id="@+id/btnSettingsAlert"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:contentDescription="@string/icono"
                    android:src="@drawable/settings"
                    app:tint="?attr/colorHeaderText"/>

            </LinearLayout>
        </RelativeLayout>

        <TextView
            android:id="@+id/textInfoAlert"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/roboto_light"
            android:text="@string/tus_alertas"
            android:textColor="?attr/colorHeaderText"
            android:textSize="34sp" />
    </LinearLayout>

    <!-- Contenedor principal de alertas -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/headerLayoutAlert"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Alertas de productos podridos (rojas) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/productos_en_mal_estado"
                android:textSize="20sp"
                android:textColor="?attr/colorTextPrimary"
                android:fontFamily="@font/roboto_light"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvNoSpoiledProducts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/no_hay_productos_en_mal_estado"
                android:textSize="16sp"
                android:textColor="?attr/colorTextSecondary"
                android:fontFamily="@font/roboto_light"
                android:visibility="gone"
                android:gravity="center"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSpoiledAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_spoiled_alert"/>

            <!-- Alertas de productos de temporada (verdes) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/productos_de_temporada"
                android:textSize="20sp"
                android:textColor="?attr/colorTextPrimary"
                android:fontFamily="@font/roboto_light"
                android:layout_marginBottom="8dp"/>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSeasonAlerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/item_season_alert"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>