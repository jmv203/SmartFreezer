<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/profileScrollView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorBackground"
    tools:context=".ProfileActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Cabecera personalizada -->
        <LinearLayout
            android:id="@+id/headerLayoutProfile"
            android:layout_width="0dp"
            android:layout_height="175dp"
            android:orientation="vertical"
            android:background="?attr/colorHeaderBackground"
            android:padding="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/tvGreetingProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_light"
                    android:text="@string/hola_usuario"
                    android:textColor="?attr/colorHeaderText"
                    android:textSize="24sp"
                    tools:ignore="RelativeOverlap" />

                <LinearLayout
                    android:id="@+id/headerIconsProfile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/btnAccountProfile"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="24dp"
                        android:contentDescription="@string/icono_perfil"
                        android:src="@drawable/account2"
                        app:tint="?attr/colorHeaderText"/>

                    <ImageView
                        android:id="@+id/btnSettingsProfile"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:contentDescription="@string/icono_ajustes"
                        android:src="@drawable/settings"
                        app:tint="?attr/colorHeaderText"/>

                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/textInfoProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_light"
                android:text="@string/mi_perfil"
                android:textColor="?attr/colorHeaderText"
                android:textSize="34sp" />
        </LinearLayout>

        <!-- Nombre del usuario -->
        <TextView
            android:id="@+id/userNameTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nombre_del_usuario"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/colorTextPrimary"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/headerLayoutProfile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Correo del usuario -->
        <TextView
            android:id="@+id/emailTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/correo_ejemplo_com"
            android:textSize="14sp"
            android:textColor="?attr/colorTextSecondary"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/userNameTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Tarjeta de opciones de cuenta -->
        <androidx.cardview.widget.CardView
            android:id="@+id/accountOptionsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:layout_constraintTop_toBottomOf="@id/emailTextView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Opción Modificar Nombre -->
                <LinearLayout
                    android:id="@+id/editNameOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:contentDescription="@string/icono"
                        android:src="@drawable/account2"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modificar_nombre"
                        android:textSize="16sp"
                        android:textColor="?attr/colorTextPrimary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="#EEEEEE" />

                <!-- Opción Cambiar Correo -->
                <LinearLayout
                    android:id="@+id/changeEmailOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_email"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cambiar_correo_electr_nico"
                        android:textSize="16sp"
                        android:textColor="?attr/colorTextPrimary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="#EEEEEE" />

                <!-- Opción Restablecer Contraseña -->
                <LinearLayout
                    android:id="@+id/resetPasswordOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_lock"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/restablecer_contrase_a"
                        android:textSize="16sp"
                        android:textColor="?attr/colorTextPrimary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta de Preferencias -->
        <androidx.cardview.widget.CardView
            android:id="@+id/preferencesCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:layout_constraintTop_toBottomOf="@id/accountOptionsCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Título de la sección -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/preferencias"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorTextPrimary" />

                <!-- Opción Modificar Preferencias -->
                <LinearLayout
                    android:id="@+id/editPreferencesOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_wrench"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/modificar_preferencias"
                        android:contentDescription="@string/icono"
                        android:textSize="16sp"
                        android:textColor="?attr/colorTextPrimary" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="#EEEEEE" />

                <!-- Preferencias actuales -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/dietTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dieta_vegetariana"
                        android:textSize="14sp"
                        android:fontFamily="@font/roboto_light"
                        android:textColor="?attr/colorTextPrimary" />

                    <TextView
                        android:id="@+id/intolerancesTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/intolerancias_gluten_lactosa"
                        android:textSize="14sp"
                        android:fontFamily="@font/roboto_light"
                        android:textColor="?attr/colorTextPrimary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Tarjeta de acciones importantes -->
        <androidx.cardview.widget.CardView
            android:id="@+id/importantActionsCard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="?attr/colorCardBackground"
            app:layout_constraintTop_toBottomOf="@id/preferencesCard"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <!-- Opción Cerrar Sesión -->
                <LinearLayout
                    android:id="@+id/logoutOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/ic_logout"
                        android:contentDescription="@string/icono"
                        app:tint="#FF5252" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/cerrar_sesi_n"
                        android:textColor="#FF5252"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="44dp"
                    android:layout_marginEnd="8dp"
                    android:background="#EEEEEE" />

                <!-- Opción Eliminar Cuenta -->
                <LinearLayout
                    android:id="@+id/deleteAccountOption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="16dp"
                        android:src="@drawable/delete"
                        android:contentDescription="@string/icono"
                        app:tint="#FF5252" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/eliminar_cuenta"
                        android:textColor="#FF5252"
                        android:textSize="16sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_chevron_right"
                        android:contentDescription="@string/icono"
                        app:tint="?attr/colorTextSecondary" />
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Espacio al final para evitar que el contenido quede oculto -->
        <View
            android:layout_width="match_parent"
            android:layout_height="32dp"
            app:layout_constraintTop_toBottomOf="@id/importantActionsCard"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>