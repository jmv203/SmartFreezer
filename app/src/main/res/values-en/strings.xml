    <string name="logo">App logo</string>
    <string name="about_title">SmartFreezer</string>
    <string name="about_description">SmartFreezer is an app that helps you manage your food, recipes, and shopping efficiently.</string>
    <string name="about_firebase">This app uses Firebase for registration, authentication, and storing personal data like inventory, shopping list, and saved recipes.</string>
    <string name="about_spoonacular">We also use the public Spoonacular API to display recipes based on your available ingredients. All rights to recipes and images belong to Spoonacular (https://spoonacular.com).</string>
