    <string name="privacy_text">- We use Firebase Authentication to securely identify you.\n- Your data such as products, saved recipes, or shopping lists is privately stored in Firestore.\n- You may delete all your information at any time from the app settings.</string>
    <string name="third_party_title">Use of Third-party Services</string>
