<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/inventoryFragment">

    <fragment
        android:id="@+id/inventoryFragment"
        android:name="com.example.smartfreezer.navigation.InventoryFragment"
        android:label="Inicio">
        <action
            android:id="@+id/action_inventoryFragment_to_selectCategoryFragment"
            app:destination="@id/selectCategoryFragment" />
        <action
            android:id="@+id/action_inventoryFragment_to_wastedProductsFragment"
            app:destination="@id/wastedProductsFragment" />
    </fragment>

    <fragment
        android:id="@+id/wastedProductsFragment"
        android:name="com.example.smartfreezer.navigation.WastedProductsFragment"
        android:label="Historial">
    <action
        android:id="@+id/action_wastedProductsFragment_to_inventoryFragment"
        app:destination="@id/inventoryFragment" />
    </fragment>

    <fragment
        android:id="@+id/listFragment"
        android:name="com.example.smartfreezer.navigation.ShoppingListFragment"
        android:label="Lista">
        <action
            android:id="@+id/action_listFragment_to_addShoppingListFragment"
            app:destination="@id/addShoppingListFragment" />
    </fragment>

    <fragment
        android:id="@+id/addShoppingListFragment"
        android:name="com.example.smartfreezer.navigation.AddShoppingListFragment"
        android:label="Añadir a la Lista" />

    <fragment
        android:id="@+id/scannerFragment"
        android:name="com.example.smartfreezer.navigation.ScannerFragment"
        android:label="Escáner" />

    <fragment
        android:id="@+id/recipesFragment"
        android:name="com.example.smartfreezer.navigation.RecipesFragment"
        android:label="Recetas">
        <action
            android:id="@+id/action_recipesFragment_to_recipeDetailsFragment"
            app:destination="@id/recipeDetailsFragment" />
        <action
            android:id="@+id/action_recipesFragment_to_savedRecipesFragment"
            app:destination="@id/savedRecipesFragment" />
    </fragment>

    <fragment
        android:id="@+id/recipeDetailsFragment"
        android:name="com.example.smartfreezer.navigation.RecipeDetailsFragment"
        android:label="Detalles de la Receta">
        <argument
            android:name="recipeId"
            app:argType="integer" />
    </fragment>

    <fragment
        android:id="@+id/alertsFragment"
        android:name="com.example.smartfreezer.navigation.AlertsFragment"
        android:label="Alertas" />

    <fragment
        android:id="@+id/selectCategoryFragment"
        android:name="com.example.smartfreezer.navigation.SelectCategoryFragment"
        android:label="Seleccionar categoría">
        <action
            android:id="@+id/action_selectCategoryFragment_to_selectProductFragment"
            app:destination="@id/selectProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/selectProductFragment"
        android:name="com.example.smartfreezer.navigation.SelectProductFragment"
        android:label="Seleccionar producto">
        <argument
            android:name="category"
            app:argType="string" />
        <action
            android:id="@+id/action_selectProductFragment_to_addProductFragment"
            app:destination="@id/addProductFragment" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.example.smartfreezer.navigation.AddProductFragment"
        android:label="Formulario producto">
        <argument
            android:name="productId"
            app:argType="string" />
        <argument
            android:name="icon"
            app:argType="string" />
        <argument
            android:name="category"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/savedRecipesFragment"
        android:name="com.example.smartfreezer.navigation.SavedRecipesFragment"
        android:label="Recetas Guardadas">
        <action
            android:id="@+id/action_savedRecipesFragment_to_recipeDetailsFragment"
            app:destination="@id/recipeDetailsFragment" />
        <action
            android:id="@+id/action_savedRecipesFragment_to_recipesFragment"
            app:destination="@id/recipesFragment" />
    </fragment>

</navigation>